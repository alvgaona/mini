<column>
  <if test="{chromeVisible}">
    <row gap="8" padding="10" cross="center" window-drag="true">
    <spacer width="62" />
    <button size="sm" variant="ghost" icon="chevron-left" label="Back" disabled="{backDisabled}" on-press="back" />
    <button size="sm" variant="ghost" icon="chevron-right" label="Forward" disabled="{forwardDisabled}" on-press="forward" />
    <button size="sm" variant="ghost" icon="refresh-cw" label="Reload" on-press="reload" />
    <text-field grow="1" size="sm" text="{addressText}" placeholder="Enter an address" label="Address" autofocus="{addressWantsFocus}" on-input="address_edit" on-submit="navigate" />
    </row>
  </if>
  <if test="{chromeVisible}">
    <row gap="2" padding="2" cross="center">
    <for each="tabRows" key="index" as="t">
      <!-- A pressable row, not a button: the row press selects, and the
           close button INSIDE it claims its own press through ordinary
           fall-through - one tab, two targets, no outboard chrome. -->
      <if test="{t.active}">
        <row on-press="select_tab:{t.index}" background="surface" radius="sm" padding="2" gap="4" cross="center" label="{t.title}">
          <image image="{t.favicon}" width="16" height="16" label="" />
          <text>{t.title}</text>
          <button size="sm" variant="ghost" icon="x" label="Close tab" on-press="close_tab:{t.index}" />
        </row>
      </if>
      <else>
        <row on-press="select_tab:{t.index}" radius="sm" padding="2" gap="4" cross="center" label="{t.title}">
          <image image="{t.favicon}" width="16" height="16" label="" />
          <text>{t.title}</text>
          <button size="sm" variant="ghost" icon="x" label="Close tab" on-press="close_tab:{t.index}" />
        </row>
      </else>
    </for>
      <button size="sm" variant="ghost" icon="plus" label="New tab" on-press="new_tab" />
      <spacer grow="1" />
    </row>
  </if>
  <panel grow="1" label="page-pane" />
</column>
