.{
    .id = "dev.native_sdk.mini",
    .name = "mini",
    .display_name = "Mini",
    .description = "A minimal personal web browser: one address bar, one Chromium page, no state.",
    .version = "0.1.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{"macos"},
    // bluetooth: the cross-device passkey flow's BLE proximity check -
    // packaged builds get NSBluetoothAlwaysUsageDescription from it.
    .permissions = .{ "view", "command", "bluetooth" },
    .capabilities = .{ "native_views", "gpu_surfaces", "webview", "shortcuts" },
    .shortcuts = .{
        .{ .id = "mini.toggle-focus", .key = "f", .modifiers = .{ "primary", "shift" } },
        .{ .id = "mini.new-tab", .key = "t", .modifiers = .{"primary"} },
        // Cmd+W is ours: a registered shortcut is swallowed app-wide
        // before the responder chain, so the window's own close-on-W
        // never runs - which is the point: tabs close first, the app
        // only when none remain.
        .{ .id = "mini.close-tab", .key = "w", .modifiers = .{"primary"} },
    },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "Mini",
                .width = 1180,
                .height = 760,
                .min_width = 640,
                .min_height = 420,
                .restore_state = true,
                .restore_policy = "clamp_to_visible_screen",
                .titlebar = "hidden_inset",
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Browser chrome", .accessibility_label = "Mini", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            // A browser's whole job is arbitrary origins. The wildcard is
            // safe only because the page webview gets no bridge: nothing
            // here creates it with `bridge: true`, and `js_window_api` is
            // off, so `window.zero` never reaches a loaded site.
            .allowed_origins = .{"*"},
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "chromium",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = true },
}
